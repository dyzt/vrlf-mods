      "config": {
        "file": "BepInEx/plugins/HotdRemakeVrlf.cfg", "format": "kv",
        "toggles": [
          { "key": "HideCrosshair", "label": "Hide crosshair", "help": "Hide the in-game crosshair for players this mod drives (aim by the VR gun)." },
          { "key": "InvertY", "label": "Invert aim Y (P1)", "help": "Flip the vertical aim axis if aim comes out upside-down." },
          { "key": "EnableAbsoluteAim", "label": "Absolute VR aim", "help": "Drive the crosshair from the framework aim bus instead of native mouse aim." },
          { "key": "EnableCoop", "label": "Enable 2-player co-op", "help": "Allow Player 2 (virtual pad) to join for co-op." },
          { "key": "EnableDeviceLock", "label": "Lock input devices (co-op)", "help": "Block stray controllers so only the framework's virtual pad is assigned." },
          { "key": "LogAim", "label": "Verbose aim log", "help": "Write per-frame aim diagnostics to the log (verbose)." }
        ]
      } },
