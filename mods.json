      "notes": "Calibration covers 27 USA games. Crosshair removal hides player 1's crosshair only.",
      "options": [
        { "id": "base", "label": "Base config", "short": "Base", "version": "1.0",
          "zip": "emulators/dolphin/dist/dolphin-base-v1.0.zip", "sha256": "2fd2e176fb378114d1a1c6706c9d916c19b41b602cba52df086cb33382c25288" },
