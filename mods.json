        { "id": "base", "label": "Base config", "short": "Base", "version": "1.0",
          "zip": "emulators/pcsx2x6/dist/pcsx2x6-base-v1.0.zip", "sha256": "9793acc62643fb6f52b5bfaaf69c5f80791071680072f175578b64ab79a2e7e4" } ] },
